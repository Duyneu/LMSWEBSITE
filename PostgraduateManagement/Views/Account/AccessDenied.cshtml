@* File: Views/Account/AccessDenied.cshtml *@
@{
    ViewData["Title"] = "Từ chối Quyền truy cập";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-6 text-center">
        <div class="card shadow-sm border-danger border-opacity-25 p-5 bg-white">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-lock-fill" style="font-size: 4rem;"></i>
            </div>
            <h2 class="h3 fw-bold text-dark mb-2">Từ chối Quyền Truy cập (403 Forbidden)</h2>
            <p class="text-muted mb-4">
                Tài khoản của bạn không có đủ thẩm quyền theo quy định để thực hiện thao tác hoặc truy cập vào chức năng này trong Module M05 – Quản lý Sau đại học.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Thesis" asp-action="Index" class="btn btn-primary px-4">
                    <i class="bi bi-house-door me-1"></i>Về trang chủ Đề tài
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập tài khoản khác
                </a>
            </div>
        </div>
    </div>
</div>
