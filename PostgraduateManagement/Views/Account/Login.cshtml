@* File: Views/Account/Login.cshtml *@
@model PostgraduateManagement.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập Hệ thống Sau đại học";
}

<div class="auth-sheet py-4">
        <h1 class="h3 mb-1">Đăng nhập</h1>
        <p class="text-muted mb-4">Hệ thống Quản lý Sau đại học, module M05</p>

        <div class="card mb-4">
            <div class="card-body p-4">
                <form asp-action="Login" method="post">
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3 py-2 small" role="alert"></div>

                    <!-- Tên đăng nhập / Email -->
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-semibold text-dark">Tên đăng nhập / Email</label>
                        <input asp-for="Username" id="loginUsername" class="form-control" placeholder="admin@lms.edu.vn" autocomplete="username" required />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <!-- Mật khẩu -->
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold text-dark">Mật khẩu</label>
                        <input asp-for="Password" id="loginPassword" class="form-control" type="password" autocomplete="current-password" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <!-- Ghi nhớ -->
                    <div class="mb-4 form-check">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                        <label asp-for="RememberMe" class="form-check-label text-muted small">Ghi nhớ đăng nhập trên thiết bị này</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        Đăng nhập Hệ thống
                    </button>
                </form>
            </div>
        </div>

        <!-- DEMO ACCOUNTS SHOWCASE (TÀI KHOẢN MẪU THỬ NGHIỆM) -->
        <section class="card" aria-labelledby="demoHeading">
            <div class="card-body p-3">
                <h2 id="demoHeading" class="h6 mb-1">Tài khoản Demo Thử nghiệm (M05 Showcase)</h2>
                <p class="text-muted small mb-3">Bấm một tài khoản để điền nhanh.</p>
                <div class="d-flex flex-column gap-2">
                    <button type="button" class="btn btn-sm btn-outline-dark text-start d-flex justify-content-between align-items-center btn-fill-demo"
                            data-user="admin@lms.edu.vn" data-pass="Password123!">
                        <div>
                            <span class="badge me-1">Admin</span>
                            <strong>admin@lms.edu.vn</strong>
                        </div>
                        <small class="text-muted">Quản trị toàn quyền</small>
                    </button>

                    <button type="button" class="btn btn-sm btn-outline-dark text-start d-flex justify-content-between align-items-center btn-fill-demo"
                            data-user="manager@lms.edu.vn" data-pass="Password123!">
                        <div>
                            <span class="badge me-1">Manager</span>
                            <strong>manager@lms.edu.vn</strong>
                        </div>
                        <small class="text-muted">Quản lý đào tạo SĐH</small>
                    </button>

                    <button type="button" class="btn btn-sm btn-outline-dark text-start d-flex justify-content-between align-items-center btn-fill-demo"
                            data-user="tung.nt@lms.edu.vn" data-pass="Password123!">
                        <div>
                            <span class="badge me-1">Faculty</span>
                            <strong>tung.nt@lms.edu.vn</strong>
                        </div>
                        <small class="text-muted">Giảng viên / GS.TS</small>
                    </button>

                    <button type="button" class="btn btn-sm btn-outline-dark text-start d-flex justify-content-between align-items-center btn-fill-demo"
                            data-user="an.nv@student.lms.edu.vn" data-pass="Password123!">
                        <div>
                            <span class="badge me-1">Student</span>
                            <strong>an.nv@student.lms.edu.vn</strong>
                        </div>
                        <small class="text-muted">Học viên SĐH</small>
                    </button>

                    <button type="button" class="btn btn-sm btn-outline-dark text-start d-flex justify-content-between align-items-center btn-fill-demo"
                            data-user="que.td@lms.edu.vn" data-pass="Password123!">
                        <div>
                            <span class="badge me-1">Committee</span>
                            <strong>que.td@lms.edu.vn</strong>
                        </div>
                        <small class="text-muted">Hội đồng / PGS.TS</small>
                    </button>
                </div>
                <p class="text-muted small mt-3 mb-0">
                    Mật khẩu chung cho tất cả tài khoản mẫu: <code>Password123!</code>
                </p>
            </div>
        </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var demoButtons = document.querySelectorAll(".btn-fill-demo");
            var userInput = document.getElementById("loginUsername");
            var passInput = document.getElementById("loginPassword");

            demoButtons.forEach(function (btn) {
                btn.addEventListener("click", function () {
                    if (userInput) userInput.value = this.dataset.user;
                    if (passInput) passInput.value = this.dataset.pass;
                });
            });
        });
    </script>
}
