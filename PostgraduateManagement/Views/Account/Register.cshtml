@* File: Views/Account/Register.cshtml *@
@model PostgraduateManagement.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký Tài khoản Người dùng";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom text-center">
                <h5 class="card-title mb-0 fw-bold text-dark">
                    <i class="bi bi-person-plus text-primary me-2"></i>Đăng ký Tài khoản Mới
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3 py-2 small" role="alert"></div>

                    <!-- Tên đăng nhập -->
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-semibold text-dark">Tên đăng nhập <span class="text-danger">*</span></label>
                        <input asp-for="Username" class="form-control" placeholder="nguyenvana" required />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold text-dark">Địa chỉ Email <span class="text-danger">*</span></label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="vana.nguyen@lms.edu.vn" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Mật khẩu -->
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold text-dark">Mật khẩu <span class="text-danger">*</span></label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <!-- Xác nhận mật khẩu -->
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold text-dark">Xác nhận mật khẩu <span class="text-danger">*</span></label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="••••••••" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <!-- Vai trò người dùng -->
                    <div class="mb-4">
                        <label asp-for="Role" class="form-label fw-semibold text-dark">Vai trò trong hệ thống <span class="text-danger">*</span></label>
                        <select asp-for="Role" class="form-select">
                            <option value="Student">Học viên sau đại học (Student)</option>
                            <option value="Faculty">Cán bộ / Giảng viên (Faculty)</option>
                            <option value="Committee">Thành viên Hội đồng (Committee)</option>
                            <option value="Manager">Quản lý đào tạo (Manager)</option>
                            <option value="Admin">Quản trị viên (Admin)</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm mb-3">
                        <i class="bi bi-person-check me-1"></i>Hoàn tất Đăng ký
                    </button>

                    <div class="text-center text-muted small">
                        Đã có tài khoản? <a asp-action="Login" class="text-primary fw-semibold">Đăng nhập ngay</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
