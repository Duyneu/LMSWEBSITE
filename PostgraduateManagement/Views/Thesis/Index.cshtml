@* File: Views/Thesis/Index.cshtml *@
@model PostgraduateManagement.ViewModels.ThesisListViewModel
@{
    ViewData["Title"] = "Quản lý Đề tài Sau đại học";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-journal-bookmark text-primary me-2"></i>Quản lý Đề tài Sau đại học
        </h2>
        <p class="text-muted mb-0">Hồ sơ theo dõi đề án thạc sĩ, luận văn thạc sĩ và luận án tiến sĩ</p>
    </div>
    <div class="d-flex gap-2 mt-3 mt-md-0">
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center shadow-sm">
            <i class="bi bi-plus-circle me-2"></i>Đăng ký đề tài mới
        </a>
    </div>
</div>

<!-- Thẻ tìm kiếm và lọc đa tiêu chí -->
<div class="card shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-12 col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Tìm kiếm theo mã, tên đề tài, học viên..." />
                </div>
            </div>
            <div class="col-6 col-md-3">
                <select name="status" class="form-select" asp-items="Model.StatusOptions">
                </select>
            </div>
            <div class="col-6 col-md-3">
                <select name="type" class="form-select" asp-items="Model.TypeOptions">
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-filter me-1"></i>Lọc
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Danh sách đề tài -->
<div class="card shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-semibold text-secondary">
            <i class="bi bi-table me-2"></i>Tổng số bản ghi: <strong class="text-dark">@Model.TotalCount</strong> đề tài
        </span>
        <span class="badge bg-light text-muted border">Trang @Model.Page / @(Model.TotalPages == 0 ? 1 : Model.TotalPages)</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-secondary small text-uppercase">
                <tr>
                    <th scope="col" style="width: 130px;">Mã số</th>
                    <th scope="col">Tên đề tài &amp; Học viên</th>
                    <th scope="col" style="width: 140px;">Loại hình</th>
                    <th scope="col">Hướng dẫn</th>
                    <th scope="col" style="width: 150px;">Phân loại</th>
                    <th scope="col" style="width: 180px;">Trạng thái</th>
                    <th scope="col" class="text-end" style="width: 220px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Theses.Any())
                {
                    foreach (var item in Model.Theses)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace px-2 py-1">@item.Code</span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-primary">
                                        @item.Title
                                    </a>
                                </div>
                                <div class="small text-muted mt-1">
                                    <i class="bi bi-person me-1"></i>@item.StudentName
                                    <span class="text-secondary font-monospace">(@item.StudentCode)</span>
                                    <span class="mx-1">•</span>
                                    <i class="bi bi-tag me-1"></i>@item.Field
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-secondary-subtle text-secondary-emphasis border">@item.ThesisTypeName</span>
                            </td>
                            <td>
                                <div class="small text-dark">@item.SupervisorNames</div>
                            </td>
                            <td>
                                @if (item.IsGraduationCapstone)
                                {
                                    <span class="badge badge-capstone d-inline-flex align-items-center">
                                        <i class="bi bi-mortarboard-fill me-1"></i>Tốt nghiệp
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-nckh d-inline-flex align-items-center">
                                        <i class="bi bi-flask me-1"></i>Đề tài NCKH
                                    </span>
                                }
                            </td>
                            <td>
                                <partial name="_StatusBadge" model="item.ThesisStatus" />
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Chỉnh sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (item.ThesisStatus == ThesisStatus.Draft || item.ThesisStatus == ThesisStatus.Registered)
                                    {
                                        <form asp-action="Approve" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn phê duyệt đề cương đề tài này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success" title="Phê duyệt đề tài">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (item.ThesisStatus == ThesisStatus.Approved || item.ThesisStatus == ThesisStatus.InProgress)
                                    {
                                        <form asp-action="SubmitForReview" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Chuyển đề tài sang trạng thái chờ phản biện và bảo vệ?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-dark" title="Nộp phản biện &amp; bảo vệ">
                                                <i class="bi bi-send"></i>
                                            </button>
                                        </form>
                                    }
                                    <a asp-controller="SupervisorAssignment" asp-action="Index" asp-route-thesisId="@item.Id" class="btn btn-outline-info" title="Phân công chuyên gia">
                                        <i class="bi bi-people"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                            Không tìm thấy đề tài nào thỏa mãn tiêu chí lọc.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white py-3 d-flex justify-content-between align-items-center">
            <div class="small text-muted">
                Hiển thị trang @Model.Page trên tổng số @Model.TotalPages trang
            </div>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-search="@Model.Search"
                           asp-route-status="@((int?)Model.Status)"
                           asp-route-type="@((int?)Model.Type)">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@p"
                               asp-route-search="@Model.Search"
                               asp-route-status="@((int?)Model.Status)"
                               asp-route-type="@((int?)Model.Type)">
                                @p
                            </a>
                        </li>
                    }
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-search="@Model.Search"
                           asp-route-status="@((int?)Model.Status)"
                           asp-route-type="@((int?)Model.Type)">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
