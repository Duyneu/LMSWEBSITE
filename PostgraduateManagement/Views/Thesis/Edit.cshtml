@* File: Views/Thesis/Edit.cshtml *@
@model PostgraduateManagement.ViewModels.EditThesisViewModel
@{
    ViewData["Title"] = $"Chỉnh sửa Đề tài [{Model.Code}]";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="h3 fw-bold text-dark mb-1">
                    <i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh sửa Đề tài Sau đại học
                </h2>
                <p class="text-muted mb-0">Cập nhật thông tin đề tài, điều chỉnh trạng thái và tiến độ thực hiện</p>
            </div>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Quay lại chi tiết
            </a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold text-dark">
                    <i class="bi bi-card-checklist text-primary me-2"></i>Thông tin Chỉnh sửa
                </h5>
                <span class="badge bg-light text-dark border font-monospace">ID: @Model.Id</span>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <!-- Thông tin cố định của học viên -->
                    <div class="card bg-light border-0 p-3 mb-4">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="small text-muted d-block">Học viên thực hiện:</span>
                                <span class="fw-bold text-dark fs-6">@(Model.StudentName ?? "Chưa xác định")</span>
                            </div>
                            <div>
                                <span class="small text-muted d-block">Mã đề tài:</span>
                                <span class="badge bg-dark font-monospace fs-6">@Model.Code</span>
                                <input type="hidden" asp-for="Code" />
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- Loại hình đề tài -->
                        <div class="col-12 col-md-6">
                            <label asp-for="ThesisType" class="form-label fw-semibold text-dark">
                                Loại hình đề tài <span class="text-danger">*</span>
                            </label>
                            <select asp-for="ThesisType" class="form-select" asp-items="Html.GetEnumSelectList<PostgraduateManagement.Models.Enums.ThesisType>()">
                            </select>
                            <span asp-validation-for="ThesisType" class="text-danger small"></span>
                        </div>

                        <!-- Trạng thái đề tài -->
                        <div class="col-12 col-md-6">
                            <label asp-for="ThesisStatus" class="form-label fw-semibold text-dark">
                                Trạng thái đề tài <span class="text-danger">*</span>
                            </label>
                            <select asp-for="ThesisStatus" class="form-select" asp-items="Html.GetEnumSelectList<PostgraduateManagement.Models.Enums.ThesisStatus>()">
                            </select>
                            <span asp-validation-for="ThesisStatus" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Tên đề tài -->
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold text-dark">
                            Tên đề tài <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="Title" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <!-- Lĩnh vực nghiên cứu -->
                    <div class="mb-3">
                        <label asp-for="Field" class="form-label fw-semibold text-dark">
                            Lĩnh vực nghiên cứu chuyên môn <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Field" class="form-control" />
                        <span asp-validation-for="Field" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <!-- Ngày bắt đầu -->
                        <div class="col-12 col-md-6">
                            <label asp-for="StartDate" class="form-label fw-semibold text-dark">
                                Ngày bắt đầu thực hiện <span class="text-danger">*</span>
                            </label>
                            <input asp-for="StartDate" class="form-control" type="date" />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>

                        <!-- Ngày kết thúc -->
                        <div class="col-12 col-md-6">
                            <label asp-for="EndDate" class="form-label fw-semibold text-dark">
                                Ngày dự kiến hoàn thành <span class="text-danger">*</span>
                            </label>
                            <input asp-for="EndDate" class="form-control" type="date" />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Cờ đề tài tốt nghiệp -->
                    <div class="card bg-light border p-3 mb-4">
                        <div class="form-check form-switch mb-0">
                            <input asp-for="IsGraduationCapstone" class="form-check-input fs-5" type="checkbox" id="capstoneEditSwitch" />
                            <label class="form-check-label fw-bold text-dark pt-1" for="capstoneEditSwitch">
                                Đề tài tốt nghiệp sau đại học (Graduation Capstone)
                            </label>
                        </div>
                        <div class="small text-muted mt-2">
                            <i class="bi bi-info-circle me-1"></i>Bỏ tích nếu chuyển thành đề tài NCKH (đề tài NCKH sẽ không thể lập lịch bảo vệ tốt nghiệp).
                        </div>
                    </div>

                    <!-- Tóm tắt nghiên cứu -->
                    <div class="mb-4">
                        <label asp-for="Abstract" class="form-label fw-semibold text-dark">Tóm tắt mục tiêu &amp; nội dung nghiên cứu</label>
                        <textarea asp-for="Abstract" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Abstract" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary px-4">Hủy</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="bi bi-check-lg me-1"></i>Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
