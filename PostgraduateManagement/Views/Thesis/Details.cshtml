@* File: Views/Thesis/Details.cshtml *@
@model PostgraduateManagement.ViewModels.ThesisDetailViewModel
@{
    ViewData["Title"] = $"Chi tiết Đề tài [{Model.Code}]";
}

<!-- Tiêu đề & Thanh công cụ hành động -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-dark font-monospace fs-6">@Model.Code</span>
            <partial name="_StatusBadge" model="Model.ThesisStatus" />
            @if (Model.IsGraduationCapstone)
            {
                <span class="badge badge-capstone d-inline-flex align-items-center">
                    Đề tài tốt nghiệp
                </span>
            }
            else
            {
                <span class="badge badge-nckh d-inline-flex align-items-center">
                    Đề tài NCKH (Không bảo vệ tốt nghiệp)
                </span>
            }
        </div>
        <h2 class="h3 fw-bold text-dark mb-0">@Model.Title</h2>
    </div>
    <div class="d-flex flex-wrap gap-2 mt-3 mt-md-0">
        @if (Model.ThesisStatus != ThesisStatus.Archived)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                Chỉnh sửa
            </a>
        }
        @if (Model.ThesisStatus == ThesisStatus.Completed && (User.IsInRole("Admin") || User.IsInRole("Manager")))
        {
            <form asp-action="Archive" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Lưu trữ hồ sơ đề tài? Sau khi lưu trữ sẽ không chỉnh sửa được nữa.');">
                <button type="submit" class="btn btn-secondary">
                    Lưu trữ hồ sơ
                </button>
            </form>
        }
        @if (Model.CanApprove)
        {
            <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Xác nhận phê duyệt đề tài này?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success">
                    Phê duyệt đề tài
                </button>
            </form>
        }
        @if (Model.CanSubmitForReview)
        {
            <form asp-action="SubmitForReview" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Chuyển đề tài sang trạng thái chờ phản biện và bảo vệ?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-dark">
                    Nộp phản biện
                </button>
            </form>
        }
        @if (Model.CanScheduleDefense)
        {
            <a asp-controller="DefenseSession" asp-action="Schedule" asp-route-thesisId="@Model.Id" class="btn btn-primary">
                Lập lịch bảo vệ
            </a>
        }
        <a asp-controller="SupervisorAssignment" asp-action="Index" asp-route-thesisId="@Model.Id" class="btn btn-outline-primary">
            Phân công chuyên gia
        </a>
        <a asp-controller="Document" asp-action="Index" asp-route-thesisId="@Model.Id" class="btn btn-outline-info">
            Số hóa tài liệu
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            Danh sách
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Cột trái: Thông tin học viên & Đề tài -->
    <div class="col-12 col-lg-4">
        <!-- Thẻ học viên -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="card-title mb-0 fw-bold text-dark">
                    Thông tin Học viên
                </h5>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div>
                        <h6 class="fw-bold mb-0 text-dark fs-5">@Model.StudentName</h6>
                        <span class="text-muted font-monospace">@Model.StudentCode</span>
                    </div>
                </div>
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Email:</span>
                        <span class="fw-semibold">@Model.StudentEmail</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Chuyên ngành:</span>
                        <span class="fw-semibold">@Model.StudentMajor</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Khóa tuyển sinh:</span>
                        <span class="fw-semibold">Năm @Model.StudentEnrollmentYear</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Thẻ siêu dữ liệu đề tài -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="card-title mb-0 fw-bold text-dark">
                    Thuộc tính Đề tài
                </h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Loại hình:</span>
                        <span class="fw-bold text-primary">@Model.ThesisTypeName</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Lĩnh vực:</span>
                        <span class="fw-semibold text-dark">@Model.Field</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Ngày bắt đầu:</span>
                        <span>@Model.StartDate.ToString("dd/MM/yyyy")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Dự kiến hoàn thành:</span>
                        <span>@Model.EndDate.ToString("dd/MM/yyyy")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Quy chế M05:</span>
                        @if (Model.IsGraduationCapstone)
                        {
                            <span class="text-success fw-bold">Hợp lệ tham gia bảo vệ</span>
                        }
                        else
                        {
                            <span class="text-warning fw-bold">Chặn bảo vệ (NCKH)</span>
                        }
                    </li>
                </ul>
                <div class="mt-3">
                    <label class="form-label text-muted small fw-semibold">Tóm tắt nghiên cứu:</label>
                    <p class="small text-secondary bg-light p-3 rounded border mb-0" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(Model.Abstract) ? "Chưa có nội dung tóm tắt nghiên cứu." : Model.Abstract)</p>
                </div>
            </div>
        </div>

        <!-- Thẻ tiến độ số hóa 3 loại tài liệu bắt buộc M05 -->
        @if (Model.DigitizationProgress != null)
        {
            <div class="card shadow-sm border-primary border-opacity-25">
                <div class="card-header bg-primary bg-opacity-10 py-3">
                    <h5 class="card-title mb-0 fw-bold text-primary">
                        Tiến độ Số hóa M05
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-semibold text-dark">Tỷ lệ hoàn thành (3 loại tài liệu):</span>
                        <span class="badge bg-primary fs-6">@Model.DigitizationProgress.ProgressPercentage.ToString("F1")%</span>
                    </div>
                    <div class="progress mb-3" style="height: 12px;">
                        <div class="progress-bar @(Model.DigitizationProgress.ProgressPercentage == 100 ? "bg-success" : "bg-primary")"
                             role="progressbar"
                             style="width: @Model.DigitizationProgress.ProgressPercentage%;"
                             aria-valuenow="@Model.DigitizationProgress.ProgressPercentage"
                             aria-valuemin="0"
                             aria-valuemax="100">
                        </div>
                    </div>
                    <ul class="list-group list-group-flush small">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span>1. Thuyết minh đề tài</span>
                            @if (Model.DigitizationProgress.HasThuyetMinh)
                            {
                                <span class="badge bg-success">Đã nộp</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Chưa nộp</span>
                            }
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span>2. Toàn văn luận văn/luận án</span>
                            @if (Model.DigitizationProgress.HasToanVan)
                            {
                                <span class="badge bg-success">Đã nộp</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Chưa nộp</span>
                            }
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span>3. Biên bản sửa đổi sau bảo vệ</span>
                            @if (Model.DigitizationProgress.HasBienBanSuaDoi)
                            {
                                <span class="badge bg-success">Đã nộp</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Chưa nộp</span>
                            }
                        </li>
                    </ul>
                    <div class="alert alert-warning py-2 px-3 small mt-3 mb-0 border-warning border-opacity-50">
                        
                        @Model.DigitizationProgress.DisclaimerNote
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Cột phải: Các Tabs (Phân công, Thẩm định, Phiên bảo vệ, Tài liệu) -->
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white p-0">
                <ul class="nav nav-tabs card-header-tabs m-0 px-3 pt-2" id="thesisTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-semibold" id="assignments-tab" data-bs-toggle="tab" data-bs-target="#assignments" type="button" role="tab" aria-controls="assignments" aria-selected="true">
                            Phân công chuyên gia
                            <span class="badge bg-secondary rounded-pill ms-1">@Model.Assignments.Count</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-semibold" id="eligibility-tab" data-bs-toggle="tab" data-bs-target="#eligibility" type="button" role="tab" aria-controls="eligibility" aria-selected="false">
                            Thẩm định điều kiện
                            <span class="badge bg-secondary rounded-pill ms-1">@Model.EligibilityChecks.Count</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-semibold" id="defense-tab" data-bs-toggle="tab" data-bs-target="#defense" type="button" role="tab" aria-controls="defense" aria-selected="false">
                            Phiên bảo vệ &amp; Điểm số
                            <span class="badge bg-secondary rounded-pill ms-1">@Model.DefenseSessions.Count</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-semibold" id="documents-tab" data-bs-toggle="tab" data-bs-target="#documents" type="button" role="tab" aria-controls="documents" aria-selected="false">
                            Tài liệu số hóa
                            <span class="badge bg-secondary rounded-pill ms-1">@Model.SubmittedDocuments.Count</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-semibold" id="progress-tab" data-bs-toggle="tab" data-bs-target="#progress" type="button" role="tab" aria-controls="progress" aria-selected="false">
                            Tiến độ thực hiện
                            <span class="badge bg-secondary rounded-pill ms-1">@Model.ProgressReports.Count</span>
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body p-4 tab-content" id="thesisTabContent">
                <!-- Tab 1: Phân công chuyên gia -->
                <div class="tab-pane fade show active" id="assignments" role="tabpanel" aria-labelledby="assignments-tab">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-dark mb-0">Danh sách Cán bộ hướng dẫn, Phản biện và Hội đồng</h6>
                        <a asp-controller="SupervisorAssignment" asp-action="Index" asp-route-thesisId="@Model.Id" class="btn btn-sm btn-primary">
                            Quản lý phân công
                        </a>
                    </div>
                    @if (Model.Assignments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle mb-0">
                                <thead class="table-light small text-secondary">
                                    <tr>
                                        <th>Vai trò</th>
                                        <th>Chuyên gia / Cán bộ</th>
                                        <th>Học vị &amp; Đơn vị</th>
                                        <th>Loại hình</th>
                                        <th>Ngày phân công</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var assign in Model.Assignments)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@assign.RoleName</span>
                                            </td>
                                            <td>
                                                <div class="fw-bold text-dark">@assign.PersonName</div>
                                                <div class="small text-muted font-monospace">@assign.SharedPersonCode</div>
                                            </td>
                                            <td>
                                                <div class="small fw-semibold text-dark">@assign.AcademicDegreeName</div>
                                                <div class="small text-muted">@(assign.Workplace ?? "Trường Đại học")</div>
                                            </td>
                                            <td>
                                                @if (assign.IsExternal)
                                                {
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning">
                                                        Chuyên gia ngoài trường
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success-subtle text-success-emphasis border border-success">
                                                        Nội bộ
                                                    </span>
                                                }
                                            </td>
                                            <td class="small text-muted">@assign.AssignedAt.ToString("dd/MM/yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary text-center py-4 mb-0">
                            
                            Đề tài này hiện chưa được phân công cán bộ chuyên môn nào.
                        </div>
                    }
                </div>

                <!-- Tab 2: Thẩm định điều kiện quy chế -->
                <div class="tab-pane fade" id="eligibility" role="tabpanel" aria-labelledby="eligibility-tab">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-dark mb-0">Lịch sử thẩm định điều kiện theo Quy chế Đào tạo Sau đại học</h6>
                        <span class="badge bg-light text-dark border">Quy chuẩn M05</span>
                    </div>
                    @if (Model.EligibilityChecks.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle mb-0">
                                <thead class="table-light small text-secondary">
                                    <tr>
                                        <th>Chuyên gia thẩm định</th>
                                        <th>Vai trò</th>
                                        <th>Kết quả</th>
                                        <th>Căn cứ quy chế</th>
                                        <th>Phiên bản</th>
                                        <th>Thời gian</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var check in Model.EligibilityChecks)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-bold text-dark">@check.PersonName</div>
                                                <div class="small text-muted">Học vị: @check.AcademicDegree</div>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border">@check.RoleName</span>
                                            </td>
                                            <td>
                                                <partial name="_StatusBadge" model="check.Result" />
                                            </td>
                                            <td class="small text-dark">@check.Basis</td>
                                            <td class="small font-monospace">@check.RegulationVersion</td>
                                            <td class="small text-muted">@check.CheckedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary text-center py-4 mb-0">
                            
                            Chưa có dữ liệu thẩm định quy chế cho đề tài này.
                        </div>
                    }
                </div>

                <!-- Tab 3: Phiên bảo vệ & Điểm số -->
                <div class="tab-pane fade" id="defense" role="tabpanel" aria-labelledby="defense-tab">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-dark mb-0">Thông tin Lập lịch &amp; Kết quả Hội đồng Đánh giá</h6>
                        @if (Model.CanScheduleDefense)
                        {
                            <a asp-controller="DefenseSession" asp-action="Schedule" asp-route-thesisId="@Model.Id" class="btn btn-sm btn-primary">
                                Lập lịch bảo vệ
                            </a>
                        }
                    </div>
                    @if (Model.DefenseSessions.Any())
                    {
                        foreach (var session in Model.DefenseSessions)
                        {
                            <div class="border rounded p-3 mb-3 bg-light">
                                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                                    <div>
                                        <span class="fw-bold text-dark fs-5">
                                            @session.ScheduledAt.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                        <span class="text-secondary ms-3">
                                            @session.Location
                                        </span>
                                    </div>
                                    <div>
                                        <partial name="_StatusBadge" model="session.Status" />
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(session.CommitteeNotes))
                                {
                                    <div class="small text-muted mb-3">
                                        <strong>Ghi chú hội đồng:</strong> @session.CommitteeNotes
                                    </div>
                                }
                                @if (session.Result != null)
                                {
                                    <div class="card border-success border-opacity-50 bg-white">
                                        <div class="card-body p-3">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="badge @(session.Result.Pass ? "bg-success" : "bg-danger") fs-6 px-3 py-2">
                                                        @(session.Result.Pass ? "ĐẠT YÊU CẦU" : "KHÔNG ĐẠT")
                                                    </span>
                                                    <span class="fs-4 fw-bold text-primary">@session.Result.Score.ToString("F1") / 10.0</span>
                                                </div>
                                                <div class="small text-muted">
                                                    Ghi nhận bởi: <strong>@session.Result.RecordedBy</strong> (@session.Result.RecordedAt.ToString("dd/MM/yyyy"))
                                                </div>
                                            </div>
                                            <div class="small text-secondary mt-2">
                                                <strong>Nhận xét hội đồng:</strong> @session.Result.Comments
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex justify-content-between align-items-center pt-2">
                                        <span class="small text-muted">Chưa ghi nhận kết quả điểm số</span>
                                        @if (session.CanRecordResult)
                                        {
                                            <a asp-controller="DefenseSession" asp-action="RecordResult" asp-route-sessionId="@session.Id" class="btn btn-sm btn-outline-success">
                                                Nhập điểm &amp; Kết luận
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-secondary text-center py-4 mb-0">
                            
                            Đề tài này chưa được lập lịch phiên bảo vệ nào.
                        </div>
                    }
                </div>

                <!-- Tab 4: Tài liệu số hóa -->
                <div class="tab-pane fade" id="documents" role="tabpanel" aria-labelledby="documents-tab">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-dark mb-0">Danh sách văn bản nộp lưu chiểu (Thuộc danh mục bắt buộc M05)</h6>
                        <a asp-controller="Document" asp-action="Upload" asp-route-thesisId="@Model.Id" class="btn btn-sm btn-info text-dark">
                            Tải lên tài liệu mới
                        </a>
                    </div>
                    @if (Model.SubmittedDocuments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle mb-0">
                                <thead class="table-light small text-secondary">
                                    <tr>
                                        <th>Loại tài liệu</th>
                                        <th>Tên tệp</th>
                                        <th>Phiên bản</th>
                                        <th>Ngày nộp</th>
                                        <th>Xác nhận</th>
                                        <th class="text-end">Tải về</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var doc in Model.SubmittedDocuments)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-secondary-subtle text-secondary-emphasis border">@doc.DocumentTypeName</span>
                                            </td>
                                            <td class="fw-semibold text-dark">
                                                @doc.FileName
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border font-monospace">v@doc.Version</span>
                                            </td>
                                            <td class="small text-muted">@doc.UploadedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                @if (doc.IsConfirmed)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success">
                                                        @doc.ConfirmedBy
                                                    </span>
                                                    <div class="small text-muted">@doc.ConfirmedAt?.ToString("dd/MM/yyyy HH:mm")</div>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning">
                                                        Chờ duyệt
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <a href="@doc.FilePath" class="btn btn-sm btn-outline-primary" download target="_blank">
                                                    <i class="bi bi-download"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary text-center py-4 mb-0">
                            
                            Chưa có tài liệu số hóa nào được nộp cho đề tài này.
                        </div>
                    }
                </div>

                <!-- Tab 5: Tiến độ thực hiện -->
                <div class="tab-pane fade" id="progress" role="tabpanel" aria-labelledby="progress-tab">
                    <h6 class="fw-bold text-dark mb-3">Báo cáo tiến độ và nhận xét của người hướng dẫn</h6>

                    @if (Model.CanReportProgress)
                    {
                        <form asp-action="AddProgressReport" method="post" class="note-panel mb-4">
                            <input type="hidden" name="thesisId" value="@Model.Id" />
                            <div class="row g-3">
                                <div class="col-12 col-md-9">
                                    <label for="progressContent" class="form-label fw-semibold small">Công việc đã thực hiện</label>
                                    <textarea id="progressContent" name="content" rows="2" maxlength="2000" class="form-control" required></textarea>
                                </div>
                                <div class="col-12 col-md-3">
                                    <label for="progressPercent" class="form-label fw-semibold small">Hoàn thành (%)</label>
                                    <input id="progressPercent" name="percentComplete" type="number" min="0" max="100" value="@(Model.ProgressReports.FirstOrDefault()?.PercentComplete ?? 0)" class="form-control" required />
                                </div>
                            </div>
                            <div class="text-end mt-3">
                                <button type="submit" class="btn btn-sm btn-primary">Gửi báo cáo</button>
                            </div>
                        </form>
                    }

                    @if (Model.ProgressReports.Any())
                    {
                        <ul class="list-group">
                            @foreach (var r in Model.ProgressReports)
                            {
                                <li class="list-group-item">
                                    <div class="d-flex justify-content-between flex-wrap gap-2 mb-1">
                                        <span class="small text-muted">@r.SubmittedBy, <time>@r.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</time></span>
                                        <span class="badge bg-primary">@r.PercentComplete%</span>
                                    </div>
                                    <div class="progress mb-2" style="height: 6px;" role="progressbar" aria-label="Mức hoàn thành" aria-valuenow="@r.PercentComplete" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar" style="width: @r.PercentComplete%"></div>
                                    </div>
                                    <div style="white-space: pre-line;">@r.Content</div>

                                    @if (!string.IsNullOrEmpty(r.SupervisorFeedback))
                                    {
                                        <div class="border-start border-3 border-success ps-3 mt-2 small">
                                            <div class="fw-semibold text-success">Nhận xét của người hướng dẫn</div>
                                            <div style="white-space: pre-line;">@r.SupervisorFeedback</div>
                                            <div class="text-muted">@r.FeedbackBy, <time>@r.FeedbackAt?.ToString("dd/MM/yyyy HH:mm")</time></div>
                                        </div>
                                    }
                                    @if (Model.CanGiveFeedback)
                                    {
                                        <form asp-action="GiveProgressFeedback" method="post" class="mt-2 d-flex gap-2">
                                            <input type="hidden" name="reportId" value="@r.Id" />
                                            <input name="feedback" maxlength="2000" class="form-control form-control-sm" placeholder="@(string.IsNullOrEmpty(r.SupervisorFeedback) ? "Nhận xét báo cáo này..." : "Cập nhật nhận xét...")" aria-label="Nhận xét báo cáo tiến độ" required />
                                            <button type="submit" class="btn btn-sm btn-outline-success text-nowrap">Lưu nhận xét</button>
                                        </form>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="alert alert-secondary text-center py-4 mb-0">
                            
                            Chưa có báo cáo tiến độ nào.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
