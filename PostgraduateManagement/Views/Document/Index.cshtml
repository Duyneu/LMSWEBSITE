@* File: Views/Document/Index.cshtml *@
@model PostgraduateManagement.ViewModels.DocumentIndexViewModel
@{
    ViewData["Title"] = "Quản lý Số hóa Tài liệu Sau đại học";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-dark mb-1">
            Quản lý Số hóa Tài liệu Sau đại học
        </h2>
        <p class="text-muted mb-0">Lưu trữ, quản lý phiên bản và phê duyệt 03 loại tài liệu nộp lưu chiểu bắt buộc</p>
    </div>
    <!-- Chuyển đổi chọn đề tài -->
    <div class="d-flex align-items-center gap-2 mt-3 mt-md-0">
        <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
            <label class="form-label mb-0 small fw-semibold text-secondary text-nowrap">Chọn đề tài:</label>
            <select name="thesisId" class="form-select form-select-sm" onchange="this.form.submit()" style="max-width: 380px;">
                @foreach (var t in Model.AvailableTheses)
                {
                    <option value="@t.Value" selected="@t.Selected">@t.Text</option>
                }
            </select>
        </form>
    </div>
</div>

@if (Model.ThesisId > 0)
{
    <!-- Card thông tin đề tài -->
    <div class="card shadow-sm border-0 mb-4 bg-white">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-12 col-md-8">
                    <span class="badge bg-dark font-monospace mb-1">@Model.ThesisCode</span>
                    <h4 class="fw-bold text-dark mb-1">@Model.ThesisTitle</h4>
                    <div class="text-muted small">
                        Học viên thực hiện: <strong class="text-dark">@Model.StudentName</strong>
                        <span class="text-secondary font-monospace ms-1">(@Model.StudentCode)</span>
                    </div>
                </div>
                <div class="col-12 col-md-4 text-md-end mt-3 mt-md-0">
                    <a asp-action="DigitizationReport" asp-route-thesisId="@Model.ThesisId" class="btn btn-outline-primary btn-sm me-2">
                        Báo cáo tiến độ chi tiết
                    </a>
                    <a asp-action="Upload" asp-route-thesisId="@Model.ThesisId" class="btn btn-primary btn-sm">
                        Tải lên tài liệu
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- DIGITIZATION PROGRESS DASHBOARD (DASHBOARD TIẾN ĐỘ SỐ HÓA) -->
    @if (Model.DigitizationProgress != null)
    {
        <div class="card mb-4">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <h5 class="mb-1">Dashboard Tiến độ Số hóa Tài liệu</h5>
                        <span class="text-muted small">Áp dụng cho 03 loại tài liệu bắt buộc theo danh mục Module M05</span>
                    </div>
                    <div class="h4 mb-0 font-monospace @(Model.DigitizationProgress.ProgressPercentage == 100 ? "text-success" : "")">
                        @Model.DigitizationProgress.ProgressPercentage.ToString("F1")%
                    </div>
                </div>

                <!-- Thanh tiến trình -->
                <div class="progress mb-2" role="progressbar" aria-label="Tiến độ số hóa"
                     aria-valuenow="@Model.DigitizationProgress.ProgressPercentage" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar @(Model.DigitizationProgress.ProgressPercentage == 100 ? "bg-success" : "")"
                         style="width: @Model.DigitizationProgress.ProgressPercentage%;"></div>
                </div>
                <p class="small text-muted mb-4">@Model.DigitizationProgress.UploadedDocumentsCount / @Model.DigitizationProgress.TotalRequiredDocuments văn bản (@Model.DigitizationProgress.ProgressPercentage.ToString("F1")%)</p>

                <!-- Itemized Checklist cho 3 loại văn bản bắt buộc -->
                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-4">
                        <div class="note-panel h-100 @(Model.DigitizationProgress.HasThuyetMinh ? "is-settled" : "")">
                            <h6 class="mb-2">1. Thuyết minh đề tài</h6>
                            @if (Model.DigitizationProgress.HasThuyetMinh)
                            {
                                <span class="badge bg-success">Đã nộp số hóa</span>
                            }
                            else
                            {
                                <span class="badge">Chưa hoàn thành</span>
                            }
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="note-panel h-100 @(Model.DigitizationProgress.HasToanVan ? "is-settled" : "")">
                            <h6 class="mb-2">2. Toàn văn luận văn / luận án</h6>
                            @if (Model.DigitizationProgress.HasToanVan)
                            {
                                <span class="badge bg-success">Đã nộp số hóa</span>
                            }
                            else
                            {
                                <span class="badge">Chưa hoàn thành</span>
                            }
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="note-panel h-100 @(Model.DigitizationProgress.HasBienBanSuaDoi ? "is-settled" : "")">
                            <h6 class="mb-2">3. Biên bản sửa đổi sau bảo vệ</h6>
                            @if (Model.DigitizationProgress.HasBienBanSuaDoi)
                            {
                                <span class="badge bg-success">Đã nộp số hóa</span>
                            }
                            else
                            {
                                <span class="badge">Chưa hoàn thành</span>
                            }
                        </div>
                    </div>
                </div>

                <!-- MANDATORY BOUNDARY DISCLAIMER NOTICE (THÔNG BÁO RANH GIỚI BẮT BUỘC) -->
                <div class="alert alert-warning mb-0 py-2 px-3" role="note">
                    <div class="small">
                        @Model.DigitizationProgress.DisclaimerNote
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row g-4">
        <!-- Danh sách tài liệu đã tải lên (8 cols) -->
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-bold text-dark">
                        Danh mục Tài liệu Đã Nộp Lưu chiểu
                    </h5>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                        @Model.Documents.Count tệp tin
                    </span>
                </div>
                <div class="card-body p-0">
                    @if (Model.Documents.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light text-secondary small">
                                    <tr>
                                        <th>Loại tài liệu</th>
                                        <th>Tệp tin</th>
                                        <th>Phiên bản</th>
                                        <th>Thời gian nộp</th>
                                        <th>Trạng thái duyệt</th>
                                        <th class="text-end">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var doc in Model.Documents)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge @(doc.DocumentType == PostgraduateManagement.Models.Enums.DocumentType.ThuyetMinh ? "bg-info text-dark" : doc.DocumentType == PostgraduateManagement.Models.Enums.DocumentType.ToanVan ? "bg-primary" : "bg-secondary")">
                                                    @doc.DocumentTypeName
                                                </span>
                                            </td>
                                            <td>
                                                <div class="fw-bold text-dark">
                                                    @doc.FileName
                                                </div>
                                                @if (!string.IsNullOrEmpty(doc.Sha256Hash))
                                                {
                                                    <div class="small text-muted font-monospace" title="Mã xác thực toàn vẹn SHA-256: @doc.Sha256Hash">
                                                        SHA-256: @(doc.Sha256Hash.Length > 16 ? doc.Sha256Hash.Substring(0, 16) + "..." : doc.Sha256Hash)
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border font-monospace">v@(doc.Version)</span>
                                            </td>
                                            <td class="small text-muted">@doc.UploadedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                @if (doc.IsConfirmed)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success">
                                                        @doc.ConfirmedBy
                                                    </span>
                                                    <div class="small text-muted">@doc.ConfirmedAt?.ToString("dd/MM/yyyy HH:mm")</div>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning">
                                                        Chờ xác nhận
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <div class="row-actions">
                                                    @if (!doc.IsConfirmed && (User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Committee")))
                                                    {
                                                        <form asp-action="Confirm" method="post" onsubmit="return confirm('Xác nhận tính hợp lệ của tài liệu nộp này?');">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="documentId" value="@doc.Id" />
                                                            <input type="hidden" name="thesisId" value="@Model.ThesisId" />
                                                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Phê duyệt văn bản">Duyệt</button>
                                                        </form>
                                                    }
                                                    <a asp-action="Download" asp-route-id="@doc.Id" class="btn btn-icon" title="Tải xuống tệp tin an toàn" aria-label="Tải xuống tệp tin an toàn">
                                                        <i class="bi bi-download" aria-hidden="true"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            
                            Đề tài này chưa nộp tài liệu nào. Vui lòng tải lên tài liệu theo 03 danh mục bắt buộc.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Form tải lên nhanh (4 cols) -->
        <div class="col-12 col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title mb-0 fw-bold text-dark">
                        Tải lên Tài liệu Nhanh
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Upload" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ThesisId" value="@Model.ThesisId" />

                        <!-- Loại tài liệu (giới hạn nghiêm ngặt 3 loại bắt buộc) -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">
                                Danh mục tài liệu bắt buộc <span class="text-danger">*</span>
                            </label>
                            <select name="DocumentType" class="form-select">
                                <option value="@((int)PostgraduateManagement.Models.Enums.DocumentType.ThuyetMinh)">Thuyết minh đề tài (ThuyetMinh)</option>
                                <option value="@((int)PostgraduateManagement.Models.Enums.DocumentType.ToanVan)">Toàn văn luận văn / luận án (ToanVan)</option>
                                <option value="@((int)PostgraduateManagement.Models.Enums.DocumentType.BienBanSuaDoi)">Biên bản sửa đổi sau bảo vệ (BienBanSuaDoi)</option>
                            </select>
                            <div class="form-text">Chỉ 03 loại tài liệu này được tính vào tỷ lệ số hóa M05.</div>
                        </div>

                        <!-- Chọn tệp tin -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">
                                Chọn tệp tin tải lên (PDF, DOCX) <span class="text-danger">*</span>
                            </label>
                            <input type="file" name="File" class="form-control" accept=".pdf,.docx" required />
                            <div class="form-text">Chỉ chấp nhận tệp .pdf hoặc .docx, tối đa 20MB.</div>
                        </div>

                        <!-- Ghi chú tài liệu -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark">Ghi chú phiên bản</label>
                            <textarea name="Notes" class="form-control" rows="2" placeholder="Ghi chú nội dung phiên bản tải lên..."></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 fw-semibold shadow-sm">
                            Tải lên tài liệu
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-secondary text-center py-5">
        
        Vui lòng chọn một đề tài từ danh sách để xem tiến độ số hóa và quản lý tài liệu nộp lưu chiểu.
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
