@* File: Views/Defense/Index.cshtml *@
@model PostgraduateManagement.ViewModels.DefenseIndexViewModel
@{
    ViewData["Title"] = "Hội đồng & Phiên Bảo vệ Sau đại học";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-shield-check text-primary me-2"></i>Hội đồng &amp; Phiên Bảo vệ Sau đại học
        </h2>
        <p class="text-muted mb-0">Tổ chức lịch bảo vệ, hội đồng chuyên môn và ghi nhận kết quả đánh giá</p>
    </div>
    <div class="d-flex gap-2 mt-3 mt-md-0">
        <a asp-action="Schedule" class="btn btn-primary d-flex align-items-center shadow-sm">
            <i class="bi bi-calendar-plus me-2"></i>Lập lịch bảo vệ mới
        </a>
    </div>
</div>

<!-- Thẻ tìm kiếm và lọc phiên bảo vệ -->
<div class="card shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-12 col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Tìm theo mã đề tài, tên đề tài, học viên, địa điểm..." />
                </div>
            </div>
            <div class="col-6 col-md-4">
                <select name="status" class="form-select" asp-items="Model.StatusOptions">
                </select>
            </div>
            <div class="col-6 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-filter me-1"></i>Lọc
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Danh sách các phiên bảo vệ -->
<div class="card shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-semibold text-secondary">
            <i class="bi bi-calendar-week me-2"></i>Tổng số phiên bảo vệ: <strong class="text-dark">@Model.TotalCount</strong>
        </span>
        <span class="badge bg-light text-muted border">Module M05 Defense Gate</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-secondary small text-uppercase">
                <tr>
                    <th scope="col" style="width: 170px;">Thời gian</th>
                    <th scope="col">Đề tài &amp; Học viên</th>
                    <th scope="col" style="width: 200px;">Địa điểm</th>
                    <th scope="col" style="width: 150px;">Trạng thái</th>
                    <th scope="col" style="width: 180px;">Kết quả đánh giá</th>
                    <th scope="col" class="text-end" style="width: 180px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Sessions.Any())
                {
                    foreach (var s in Model.Sessions)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">
                                    <i class="bi bi-calendar-event text-primary me-1"></i>@s.ScheduledAt.ToString("dd/MM/yyyy")
                                </div>
                                <div class="small text-muted font-monospace">
                                    <i class="bi bi-clock me-1"></i>@s.ScheduledAt.ToString("HH:mm")
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark mb-1">
                                    <a asp-controller="Thesis" asp-action="Details" asp-route-id="@s.ThesisId" class="text-decoration-none text-primary">
                                        @s.ThesisTitle
                                    </a>
                                </div>
                                <div class="small text-muted">
                                    <span class="badge bg-dark font-monospace me-1">@s.ThesisCode</span>
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border me-1">@s.ThesisTypeName</span>
                                    <span>Học viên: <strong class="text-dark">@s.StudentName</strong> (@s.StudentCode)</span>
                                </div>
                            </td>
                            <td>
                                <div class="small text-dark fw-semibold">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>@s.Location
                                </div>
                                @if (!string.IsNullOrEmpty(s.CommitteeNotes))
                                {
                                    <div class="small text-muted text-truncate" style="max-width: 190px;" title="@s.CommitteeNotes">
                                        @s.CommitteeNotes
                                    </div>
                                }
                            </td>
                            <td>
                                <partial name="_StatusBadge" model="s.Status" />
                            </td>
                            <td>
                                @if (s.Result != null)
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge @(s.Result.Pass ? "bg-success" : "bg-danger") px-2 py-1">
                                            @(s.Result.Pass ? "Đạt" : "Không đạt")
                                        </span>
                                        <span class="fw-bold fs-6 text-primary">@s.Result.Score.ToString("F1")</span>
                                    </div>
                                    <div class="small text-muted text-truncate" style="max-width: 170px;" title="@s.Result.Comments">
                                        @s.Result.Comments
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">
                                        <i class="bi bi-hourglass me-1"></i>Chưa nhập điểm
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    @if (s.CanRecordResult)
                                    {
                                        <a asp-action="RecordResult" asp-route-sessionId="@s.Id" class="btn btn-outline-success" title="Ghi nhận điểm số &amp; nhận xét">
                                            <i class="bi bi-pencil-square me-1"></i>Nhập điểm
                                        </a>
                                    }
                                    <a asp-controller="Thesis" asp-action="Details" asp-route-id="@s.ThesisId" class="btn btn-outline-secondary" title="Xem đề tài">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x fs-1 d-block mb-2 text-secondary"></i>
                            Không có phiên bảo vệ nào thỏa mãn tiêu chí tìm kiếm.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
