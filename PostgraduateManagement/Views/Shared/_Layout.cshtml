@* File: Views/Shared/_Layout.cshtml *@
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string NavClass(string controller) => currentController == controller ? "nav-link active" : "nav-link";
    string? NavCurrent(string controller) => currentController == controller ? "page" : null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Quản lý đào tạo sau đại học: đề tài, phân công hướng dẫn, hội đồng bảo vệ và lưu trữ tài liệu." />
    <title>@ViewData["Title"] - Quản lý Sau đại học (M05)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600&family=Geist+Mono:wght@400&display=swap&subset=vietnamese" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
    <header class="app-bar">
        <nav class="navbar navbar-expand-lg" aria-label="Điều hướng chính">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand" asp-controller="Thesis" asp-action="Index">Quản lý Sau đại học <span class="record-code">M05</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Mở menu điều hướng">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="@NavClass("Thesis")" aria-current="@NavCurrent("Thesis")" asp-controller="Thesis" asp-action="Index">Đề tài</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass("SupervisorAssignment")" aria-current="@NavCurrent("SupervisorAssignment")" asp-controller="SupervisorAssignment" asp-action="Index">Phân công</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass("DefenseSession")" aria-current="@NavCurrent("DefenseSession")" asp-controller="DefenseSession" asp-action="Index">Hội đồng &amp; bảo vệ</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass("Document")" aria-current="@NavCurrent("Document")" asp-controller="Document" asp-action="Index">Tài liệu số hóa</a>
                        </li>
                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <li class="nav-item">
                                <a class="@NavClass("Student")" aria-current="@NavCurrent("Student")" asp-controller="Student" asp-action="Index">Học viên</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("Expert")" aria-current="@NavCurrent("Expert")" asp-controller="Expert" asp-action="Index">Chuyên gia</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="py-4">
        <div class="container-fluid px-lg-4">
            @* Hiển thị thông báo trạng thái TempData *@
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }
            @if (TempData["WarningMessage"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center" role="alert">
                    <div>@TempData["WarningMessage"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <footer class="app-footer">
        <div class="container-fluid px-lg-4">
            Quản lý Đào tạo Sau đại học, module M05
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <partial name="_ValidationScriptsPartial" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
