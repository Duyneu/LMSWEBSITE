@* File: Views/Shared/_StatusBadge.cshtml *@
@model object

@if (Model is ThesisStatus status)
{
    switch (status)
    {
        case ThesisStatus.Draft:
            <span class="badge bg-secondary">Dự thảo</span>
            break;
        case ThesisStatus.Registered:
            <span class="badge bg-info text-dark">Đã đăng ký</span>
            break;
        case ThesisStatus.Approved:
            <span class="badge bg-primary">Đã phê duyệt</span>
            break;
        case ThesisStatus.InProgress:
            <span class="badge bg-warning text-dark">Đang thực hiện</span>
            break;
        case ThesisStatus.SubmittedForReview:
            <span class="badge bg-dark">Chờ phản biện &amp; bảo vệ</span>
            break;
        case ThesisStatus.Defended:
            <span class="badge bg-success">Đã bảo vệ</span>
            break;
        case ThesisStatus.Archived:
            <span class="badge bg-secondary">Đã lưu trữ</span>
            break;
        case ThesisStatus.Completed:
            <span class="badge bg-success">Hoàn thành</span>
            break;
        default:
            <span class="badge bg-secondary">@status.ToString()</span>
            break;
    }
}
else if (Model is DefenseStatus defenseStatus)
{
    switch (defenseStatus)
    {
        case DefenseStatus.Scheduled:
            <span class="badge bg-primary">Đã lên lịch</span>
            break;
        case DefenseStatus.InProgress:
            <span class="badge bg-warning text-dark">Đang diễn ra</span>
            break;
        case DefenseStatus.Defended:
            <span class="badge bg-success">Đã bảo vệ</span>
            break;
        case DefenseStatus.Cancelled:
            <span class="badge bg-danger">Đã hủy</span>
            break;
        default:
            <span class="badge bg-secondary">@defenseStatus.ToString()</span>
            break;
    }
}
else if (Model is CheckResult checkResult)
{
    switch (checkResult)
    {
        case CheckResult.Eligible:
            <span class="badge bg-success">Đủ điều kiện</span>
            break;
        case CheckResult.Ineligible:
            <span class="badge bg-danger">Không đủ điều kiện</span>
            break;
        case CheckResult.Conditional:
            <span class="badge bg-warning text-dark">Có điều kiện</span>
            break;
        default:
            <span class="badge bg-secondary">@checkResult.ToString()</span>
            break;
    }
}
else if (Model != null)
{
    <span class="badge bg-secondary">@Model.ToString()</span>
}
