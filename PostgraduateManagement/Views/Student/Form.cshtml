@* File: Views/Student/Form.cshtml *@
@model PostgraduateManagement.ViewModels.StudentFormViewModel
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Cập nhật hồ sơ học viên" : "Thêm hồ sơ học viên";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h3 fw-bold text-dark mb-0">
                <i class="bi bi-person-vcard text-primary me-2"></i>@ViewData["Title"]
            </h2>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? (int?)Model.Id : null)" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="SharedStudentCode" class="form-label fw-semibold">@Html.DisplayNameFor(m => m.SharedStudentCode) <span class="text-danger">*</span></label>
                            <input asp-for="SharedStudentCode" class="form-control font-monospace" placeholder="VD: HV2024001" />
                            <span asp-validation-for="SharedStudentCode" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold">@Html.DisplayNameFor(m => m.FullName) <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">@Html.DisplayNameFor(m => m.Email) <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold">@Html.DisplayNameFor(m => m.PhoneNumber)</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-8">
                            <label asp-for="Major" class="form-label fw-semibold">@Html.DisplayNameFor(m => m.Major) <span class="text-danger">*</span></label>
                            <input asp-for="Major" class="form-control" placeholder="VD: Khoa học máy tính" />
                            <span asp-validation-for="Major" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="EnrollmentYear" class="form-label fw-semibold">@Html.DisplayNameFor(m => m.EnrollmentYear) <span class="text-danger">*</span></label>
                            <input asp-for="EnrollmentYear" class="form-control" type="number" />
                            <span asp-validation-for="EnrollmentYear" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-4 mt-4 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold"><i class="bi bi-check-lg me-1"></i>Lưu hồ sơ</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
