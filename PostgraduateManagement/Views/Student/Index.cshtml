@* File: Views/Student/Index.cshtml *@
@model PostgraduateManagement.ViewModels.StudentListViewModel
@{
    ViewData["Title"] = "Hồ sơ Người học Sau đại học";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h2 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-person-vcard text-primary me-2"></i>Hồ sơ Người học Sau đại học
        </h2>
        <p class="text-muted mb-0">Học viên cao học và nghiên cứu sinh, liên kết qua mã người học dùng chung</p>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-semibold">
        <i class="bi bi-plus-lg me-1"></i>Thêm hồ sơ
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header py-3">
        <form asp-action="Index" method="get" class="d-flex gap-2" role="search">
            <input name="search" value="@Model.Search" class="form-control" placeholder="Tìm theo họ tên, mã người học, email..." aria-label="Tìm kiếm học viên" />
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i></button>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã người học</th>
                    <th>Họ và tên</th>
                    <th>Email</th>
                    <th>Chuyên ngành</th>
                    <th>Năm nhập học</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Students.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Không có hồ sơ nào.</td></tr>
                }
                @foreach (var s in Model.Students)
                {
                    <tr>
                        <td class="font-monospace">@s.SharedStudentCode</td>
                        <td class="fw-semibold">@s.FullName</td>
                        <td>@s.Email</td>
                        <td>@s.Major</td>
                        <td>@s.EnrollmentYear</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i> Sửa
                            </a>
                            <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Xóa hồ sơ học viên này?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
