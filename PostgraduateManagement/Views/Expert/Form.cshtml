@* File: Views/Expert/Form.cshtml *@
@model PostgraduateManagement.ViewModels.ExpertFormViewModel
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Cập nhật chuyên gia" : "Thêm chuyên gia";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h3 fw-bold text-dark mb-0">
                <i class="bi bi-person-badge text-primary me-2"></i>@ViewData["Title"]
            </h2>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? (int?)Model.Id : null)" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="SharedPersonCode" class="form-label fw-semibold">@Html.DisplayNameFor(m => m.SharedPersonCode)</label>
                            <input asp-for="SharedPersonCode" class="form-control font-monospace" placeholder="VD: CB0123 (để trống nếu ngoài trường)" />
                            <span asp-validation-for="SharedPersonCode" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold">@Html.DisplayNameFor(m => m.FullName) <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="AcademicDegree" class="form-label fw-semibold">@Html.DisplayNameFor(m => m.AcademicDegree) <span class="text-danger">*</span></label>
                            <select asp-for="AcademicDegree" class="form-select" asp-items="Html.GetEnumSelectList<PostgraduateManagement.Models.Enums.AcademicDegree>()"></select>
                            <span asp-validation-for="AcademicDegree" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-8">
                            <label asp-for="ResearchField" class="form-label fw-semibold">@Html.DisplayNameFor(m => m.ResearchField) <span class="text-danger">*</span></label>
                            <input asp-for="ResearchField" class="form-control" placeholder="VD: Trí tuệ nhân tạo, Xử lý ngôn ngữ tự nhiên" />
                            <span asp-validation-for="ResearchField" class="text-danger small"></span>
                            <div class="form-text">Dùng để đối sánh khi thẩm định điều kiện và gợi ý phản biện AI.</div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">@Html.DisplayNameFor(m => m.Email) <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold">@Html.DisplayNameFor(m => m.PhoneNumber)</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Workplace" class="form-label fw-semibold">@Html.DisplayNameFor(m => m.Workplace)</label>
                            <input asp-for="Workplace" class="form-control" placeholder="Trường, viện nghiên cứu hoặc doanh nghiệp" />
                            <span asp-validation-for="Workplace" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <div class="card bg-light border p-3">
                                <div class="form-check form-switch mb-0">
                                    <input asp-for="IsExternal" class="form-check-input" type="checkbox" />
                                    <label asp-for="IsExternal" class="form-check-label fw-semibold"></label>
                                </div>
                                <div class="small text-muted mt-1">Chuyên gia không thuộc biên chế trường; được tính riêng khi thẩm định cơ cấu hội đồng và phản biện độc lập.</div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-4 mt-4 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold"><i class="bi bi-check-lg me-1"></i>Lưu chuyên gia</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
