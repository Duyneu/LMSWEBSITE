@* File: Views/Assignment/Index.cshtml *@
@model PostgraduateManagement.ViewModels.AssignmentIndexViewModel
@{
    ViewData["Title"] = "Phân công Chuyên gia & Gợi ý Phản biện AI";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-people-fill text-primary me-2"></i>Phân công Chuyên gia &amp; Gợi ý Phản biện AI
        </h2>
        <p class="text-muted mb-0">Quản lý cán bộ hướng dẫn, ủy viên hội đồng và chuyên gia phản biện độc lập</p>
    </div>
    <!-- Bộ chuyển đổi chọn đề tài nhanh -->
    <div class="d-flex align-items-center gap-2 mt-3 mt-md-0">
        <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
            <label class="form-label mb-0 small fw-semibold text-secondary text-nowrap">Chọn đề tài:</label>
            <select name="thesisId" class="form-select form-select-sm" onchange="this.form.submit()" style="max-width: 380px;">
                @foreach (var t in Model.AvailableTheses)
                {
                    <option value="@t.Value" selected="@t.Selected">@t.Text</option>
                }
            </select>
        </form>
    </div>
</div>

@if (Model.SelectedThesisId.HasValue)
{
    <!-- Card tổng quan đề tài được chọn -->
    <div class="card shadow-sm border-0 mb-4 bg-white">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-12 col-md-8">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-dark font-monospace fs-6">@Model.ThesisCode</span>
                        <span class="badge bg-secondary-subtle text-secondary-emphasis border">@Model.ThesisTypeName</span>
                        <span class="badge bg-info-subtle text-info-emphasis border">
                            <i class="bi bi-tag me-1"></i>@Model.ThesisField
                        </span>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">@Model.ThesisTitle</h4>
                    <div class="text-muted small">
                        <i class="bi bi-person-fill text-primary me-1"></i>Học viên: <strong class="text-dark">@Model.StudentName</strong>
                        <span class="text-secondary font-monospace ms-1">(@Model.StudentCode)</span>
                    </div>
                </div>
                <div class="col-12 col-md-4 text-md-end mt-3 mt-md-0">
                    <a asp-controller="Thesis" asp-action="Details" asp-route-id="@Model.SelectedThesisId.Value" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-box-arrow-up-right me-1"></i>Xem hồ sơ đề tài
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Cột trái (7 cols): Danh sách phân công hiện tại & Form phân công thủ công -->
        <div class="col-12 col-lg-7">
            <!-- 1. Danh sách phân công hiện tại -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-bold text-dark">
                        <i class="bi bi-person-check-fill text-success me-2"></i>Chuyên gia Đã Phân công
                    </h5>
                    <span class="badge bg-success-subtle text-success border border-success">
                        @Model.CurrentAssignments.Count cán bộ
                    </span>
                </div>
                <div class="card-body p-0">
                    @if (Model.CurrentAssignments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light text-secondary small text-uppercase">
                                    <tr>
                                        <th>Vai trò</th>
                                        <th>Cán bộ / Chuyên gia</th>
                                        <th>Học vị &amp; Nơi công tác</th>
                                        <th>Loại hình</th>
                                        <th class="text-end">Hủy</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var assign in Model.CurrentAssignments)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge @(assign.Role == PostgraduateManagement.Models.Enums.AssignmentRole.Supervisor ? "bg-primary" : assign.Role == PostgraduateManagement.Models.Enums.AssignmentRole.Reviewer ? "bg-info text-dark" : "bg-secondary")">
                                                    @assign.RoleName
                                                </span>
                                            </td>
                                            <td>
                                                <div class="fw-bold text-dark">@assign.PersonName</div>
                                                <div class="small text-muted font-monospace">@assign.SharedPersonCode</div>
                                            </td>
                                            <td>
                                                <div class="small fw-semibold text-dark">@assign.AcademicDegreeName</div>
                                                <div class="small text-muted">@(assign.Workplace ?? "Trường Đại học")</div>
                                            </td>
                                            <td>
                                                @if (assign.IsExternal)
                                                {
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning" title="Chuyên gia ngoài trường">
                                                        <i class="bi bi-box-arrow-up-right me-1"></i>Ngoài trường
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success-subtle text-success-emphasis border border-success">
                                                        <i class="bi bi-building me-1"></i>Nội bộ
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <form asp-action="RemoveAssignment" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn hủy phân công chuyên gia này?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="assignmentId" value="@assign.Id" />
                                                    <input type="hidden" name="thesisId" value="@Model.SelectedThesisId.Value" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Hủy phân công">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-person-x fs-2 d-block mb-2 text-secondary"></i>
                            Chưa có cán bộ nào được phân công cho đề tài này.
                        </div>
                    }
                </div>
            </div>

            <!-- 2. Form phân công chuyên gia thủ công -->
            <div class="card shadow-sm border-primary border-opacity-25" id="manualAssignCard">
                <div class="card-header bg-primary bg-opacity-10 py-3">
                    <h5 class="card-title mb-0 fw-bold text-primary">
                        <i class="bi bi-person-plus-fill me-2"></i>Thực hiện Phân công Chuyên gia
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Assign" method="post" id="assignForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ThesisId" value="@Model.SelectedThesisId.Value" />

                        <!-- Chọn vai trò -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">
                                Vai trò chuyên môn <span class="text-danger">*</span>
                            </label>
                            <select name="Role" id="assignRole" class="form-select">
                                <option value="1">Người hướng dẫn (Supervisor)</option>
                                <option value="2">Người phản biện (Reviewer)</option>
                                <option value="3">Ủy viên hội đồng (Committee)</option>
                            </select>
                        </div>

                        <!-- Chọn chuyên gia -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">
                                Chọn cán bộ / chuyên gia khoa học <span class="text-danger">*</span>
                            </label>
                            <select name="PersonId" id="assignPersonId" class="form-select">
                                <option value="">-- Danh sách cán bộ / chuyên gia khả dụng --</option>
                                @foreach (var p in Model.CandidatePersons)
                                {
                                    <option value="@p.Id" data-external="@(p.IsExternal ? "true" : "false")" data-field="@p.ResearchField" data-degree="@p.AcademicDegreeName">
                                        @p.FullName (@p.AcademicDegreeName - @p.ResearchField) @(p.IsExternal ? "[Ngoài trường]" : "[Nội bộ]")
                                    </option>
                                }
                            </select>
                        </div>

                        <!-- Chuyên gia ngoài trường switch & nút kiểm tra quy chế -->
                        <div class="row align-items-center mb-3">
                            <div class="col-12 col-md-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="IsExternal" id="assignIsExternal" value="true" />
                                    <label class="form-check-label fw-semibold text-dark" for="assignIsExternal">
                                        Chuyên gia ngoài trường (IsExternal)
                                    </label>
                                </div>
                            </div>
                            <div class="col-12 col-md-6 text-md-end mt-2 mt-md-0">
                                <button type="button" class="btn btn-sm btn-outline-info" id="btnCheckEligibility">
                                    <i class="bi bi-shield-check me-1"></i>Kiểm tra điều kiện quy chế
                                </button>
                            </div>
                        </div>

                        <!-- Khung kết quả kiểm tra quy chế tức thời -->
                        <div id="eligibilityResultAlert" class="alert d-none py-2 px-3 mb-3 small" role="alert">
                            <span id="eligibilityResultText"></span>
                        </div>

                        <!-- Ghi chú phân công -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark">Ghi chú phân công</label>
                            <textarea name="Notes" id="assignNotes" class="form-control" rows="2" placeholder="Ghi chú phân công chuyên môn, quyết định phê duyệt..."></textarea>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                                <i class="bi bi-check2-circle me-1"></i>Xác nhận Phân công
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Cột phải (5 cols): AI REVIEWER SUGGESTION PANEL -->
        <div class="col-12 col-lg-5">
            <div class="card shadow-sm border-0 bg-white">
                <div class="card-header py-3 d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%); color: white; border-top-left-radius: 0.75rem; border-top-right-radius: 0.75rem;">
                    <div>
                        <h5 class="card-title mb-0 fw-bold d-flex align-items-center text-white">
                            <i class="bi bi-stars text-warning fs-5 me-2"></i>Gợi ý Phản biện AI
                        </h5>
                        <span class="small text-light opacity-75">Heuristic Recommendation Engine</span>
                    </div>
                    <span class="badge bg-warning text-dark font-monospace">AI Heuristic</span>
                </div>
                <div class="card-body p-3">
                    <!-- Banner cảnh báo tính chất tham khảo (Advisory Only) -->
                    <div class="alert alert-info py-2 px-3 small mb-3 border-info border-opacity-50 d-flex align-items-start">
                        <i class="bi bi-info-circle-fill text-info fs-5 me-2 mt-1"></i>
                        <div>
                            <strong>Khuyến nghị tham khảo độc lập (Advisory Only):</strong>
                            Thuật toán AI đối sánh độ tương đồng lĩnh vực nghiên cứu, học hàm/học vị (GS > PGS > TS) và chuyên gia ngoài trường để đưa ra đề xuất. <em>Hệ thống không tự động phân công.</em>
                        </div>
                    </div>

                    @if (Model.AiReviewerSuggestions.Any())
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var s in Model.AiReviewerSuggestions)
                            {
                                <div class="card border border-primary border-opacity-25 bg-light p-3 position-relative">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0 fs-6">@s.PersonName</h6>
                                            <div class="small text-muted">
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1">@s.AcademicDegreeName</span>
                                                @if (s.IsExternal)
                                                {
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning me-1">Ngoài trường</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-dark border me-1">Nội bộ</span>
                                                }
                                                <span class="badge bg-info-subtle text-info border border-info" title="Trạng thái đề xuất khuyến nghị AI - không tự động gán vào CSDL">@s.SuggestionState</span>
                                            </div>
                                        </div>
                                        <!-- Match Score Badge -->
                                        <div class="text-end">
                                            <div class="badge bg-primary fs-6 px-2 py-1">
                                                <i class="bi bi-bullseye me-1"></i>@s.MatchScore%
                                            </div>
                                            <div class="small text-muted" style="font-size: 0.75rem;">Độ tương đồng</div>
                                        </div>
                                    </div>

                                    <div class="small text-secondary mb-2">
                                        <i class="bi bi-mortarboard me-1"></i>Lĩnh vực: <strong>@s.ResearchField</strong>
                                        @if (!string.IsNullOrEmpty(s.Workplace))
                                        {
                                            <span class="d-block text-muted"><i class="bi bi-building me-1"></i>@s.Workplace</span>
                                        }
                                    </div>

                                    <!-- Score Breakdown Badges -->
                                    <div class="d-flex flex-wrap gap-1 mb-2">
                                        <span class="badge bg-white text-secondary border small" title="Điểm tương đồng từ khóa lĩnh vực">
                                            Lĩnh vực: +@s.FieldScore
                                        </span>
                                        <span class="badge bg-white text-secondary border small" title="Điểm trọng số học hàm/học vị">
                                            Học vị: +@s.DegreeScore
                                        </span>
                                        <span class="badge bg-white text-secondary border small" title="Ưu tiên chuyên gia ngoài trường">
                                            Ngoài trường: +@s.ExternalScore
                                        </span>
                                    </div>

                                    <!-- Detailed reasoning explanation -->
                                    <div class="p-2 rounded bg-white border small text-muted mb-3">
                                        <i class="bi bi-chat-left-quote text-primary me-1"></i>
                                        @s.Explanation
                                    </div>

                                    <!-- Nút hành động "Phân công" (Manual Assign) điền trực tiếp vào form -->
                                    <button type="button" class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center fw-semibold btn-apply-suggestion"
                                            data-person-id="@s.PersonId"
                                            data-is-external="@(s.IsExternal ? "true" : "false")"
                                            data-reason="Phân công theo khuyến nghị AI: @s.Explanation">
                                        <i class="bi bi-arrow-left-circle-fill me-2"></i>Phân công phản biện chuyên gia này
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-robot fs-1 d-block mb-2 text-secondary"></i>
                            Không có gợi ý phản biện nào phù hợp với lĩnh vực của đề tài này.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-secondary text-center py-5">
        <i class="bi bi-inbox fs-1 d-block mb-2 text-muted"></i>
        Vui lòng chọn một đề tài từ danh sách để thực hiện phân công chuyên gia và xem gợi ý phản biện AI.
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. Tự động cập nhật checkbox Chuyên gia ngoài trường khi chọn ứng viên
            var personSelect = document.getElementById("assignPersonId");
            var externalCheck = document.getElementById("assignIsExternal");

            if (personSelect && externalCheck) {
                personSelect.addEventListener("change", function () {
                    var selectedOption = personSelect.options[personSelect.selectedIndex];
                    if (selectedOption && selectedOption.dataset.external === "true") {
                        externalCheck.checked = true;
                    } else {
                        externalCheck.checked = false;
                    }
                    hideEligibilityAlert();
                });
            }

            // 2. Điền thông tin khi nhấn nút "Phân công" từ AI Reviewer Suggestion Panel
            var applyButtons = document.querySelectorAll(".btn-apply-suggestion");
            applyButtons.forEach(function (btn) {
                btn.addEventListener("click", function () {
                    var personId = this.dataset.personId;
                    var isExternal = this.dataset.isExternal === "true";
                    var reason = this.dataset.reason;

                    if (personSelect) {
                        personSelect.value = personId;
                    }
                    var roleSelect = document.getElementById("assignRole");
                    if (roleSelect) {
                        roleSelect.value = "2"; // Reviewer (AssignmentRole.Reviewer = 2)
                    }
                    if (externalCheck) {
                        externalCheck.checked = isExternal;
                    }
                    var notesText = document.getElementById("assignNotes");
                    if (notesText) {
                        notesText.value = reason;
                    }

                    // Cuộn đến form phân công và làm nổi bật
                    var formCard = document.getElementById("manualAssignCard");
                    if (formCard) {
                        formCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        formCard.classList.add("border-success", "shadow");
                        setTimeout(function () {
                            formCard.classList.remove("border-success", "shadow");
                        }, 2000);
                    }
                });
            });

            // 3. Kiểm tra điều kiện quy chế tức thời qua AJAX
            var btnCheck = document.getElementById("btnCheckEligibility");
            var alertBox = document.getElementById("eligibilityResultAlert");
            var alertText = document.getElementById("eligibilityResultText");

            function hideEligibilityAlert() {
                if (alertBox) {
                    alertBox.classList.add("d-none");
                }
            }

            if (btnCheck) {
                btnCheck.addEventListener("click", function () {
                    var thesisId = "@(Model.SelectedThesisId ?? 0)";
                    var personId = personSelect ? personSelect.value : "";
                    var role = document.getElementById("assignRole") ? document.getElementById("assignRole").value : "0";

                    if (!personId) {
                        alert("Vui lòng chọn cán bộ / chuyên gia trước khi kiểm tra điều kiện.");
                        return;
                    }

                    btnCheck.disabled = true;
                    btnCheck.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Đang kiểm tra...';

                    fetch(`/SupervisorAssignment/CheckEligibility?thesisId=${thesisId}&personId=${personId}&role=${role}`)
                        .then(response => response.json())
                        .then(data => {
                            btnCheck.disabled = false;
                            btnCheck.innerHTML = '<i class="bi bi-shield-check me-1"></i>Kiểm tra điều kiện quy chế';

                            if (data.success) {
                                alertBox.className = "alert py-2 px-3 mb-3 small";
                                if (data.result === "Eligible") {
                                    alertBox.classList.add("alert-success");
                                    alertText.innerHTML = `<strong><i class="bi bi-check-circle-fill me-1"></i>${data.resultName}:</strong> ${data.basis} (Quy chế: ${data.regulationVersion})`;
                                } else if (data.result === "Ineligible") {
                                    alertBox.classList.add("alert-danger");
                                    alertText.innerHTML = `<strong><i class="bi bi-x-circle-fill me-1"></i>${data.resultName}:</strong> ${data.basis} (Quy chế: ${data.regulationVersion})`;
                                } else {
                                    alertBox.classList.add("alert-warning");
                                    alertText.innerHTML = `<strong><i class="bi bi-exclamation-triangle-fill me-1"></i>${data.resultName}:</strong> ${data.basis} (Quy chế: ${data.regulationVersion})`;
                                }
                            } else {
                                alertBox.className = "alert alert-danger py-2 px-3 mb-3 small";
                                alertText.innerHTML = `Lỗi: ${data.message}`;
                            }
                        })
                        .catch(err => {
                            btnCheck.disabled = false;
                            btnCheck.innerHTML = '<i class="bi bi-shield-check me-1"></i>Kiểm tra điều kiện quy chế';
                            alertBox.className = "alert alert-danger py-2 px-3 mb-3 small";
                            alertText.innerHTML = `Lỗi kết nối kiểm tra: ${err}`;
                        });
                });
            }
        });
    </script>
}
